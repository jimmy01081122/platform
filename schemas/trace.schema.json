{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Event Trace Record",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "event_id",
    "event_type",
    "timestamp",
    "source"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "trace_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "token_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "event_type": {
      "type": "string"
    },
    "timestamp": {
      "type": "number"
    },
    "duration": {
      "type": [
        "number",
        "null"
      ]
    },
    "device": {
      "type": [
        "string",
        "null"
      ]
    },
    "bytes": {
      "type": [
        "integer",
        "null"
      ]
    },
    "dependencies": {
      "type": "array"
    },
    "attributes": {
      "type": "object"
    },
    "source": {
      "type": "object"
    }
  }
}
