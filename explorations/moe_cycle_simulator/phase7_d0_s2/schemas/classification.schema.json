{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moe-simulator-phase7-gputw-d0-s2-classification-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "d0_stage", "d0_status", "environment_eligibility", "formal_status", "classification_basis", "passed_observations", "blocking_findings", "observational_findings", "promotable", "next_legal_action", "authority", "retry_allowed", "resume_allowed", "model_download_performed", "gpu_workload_performed"],
  "properties": {
