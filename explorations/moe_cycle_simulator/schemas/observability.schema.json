{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgeflow.local/schemas/moe-simulator/observability-v1",
  "title": "Orthogonal observability status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "availability", "evidence_mode"],
  "properties": {
    "schema_version": {"const": "observability-v1"},
    "availability": {
      "enum": ["CONFIRMED", "CONDITIONAL", "UNAVAILABLE", "NOT_APPLICABLE"]
    },
    "evidence_mode": {
      "enum": ["MEASURED", "DERIVED", "INSTRUMENTED", "NONE"]
    },
    "expected_evidence_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["MEASURED", "DERIVED", "INSTRUMENTED"]}
    },
    "reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"availability": {"const": "CONFIRMED"}}},
      "then": {
        "properties": {
          "evidence_mode": {"enum": ["MEASURED", "DERIVED", "INSTRUMENTED"]}
        },
        "not": {"required": ["expected_evidence_modes"]}
      }
    },
    {
      "if": {"properties": {"availability": {"const": "CONDITIONAL"}}},
      "then": {
        "required": ["expected_evidence_modes", "reason"],
        "properties": {"evidence_mode": {"const": "NONE"}}
      }
    },
    {
      "if": {
        "properties": {
          "availability": {"enum": ["UNAVAILABLE", "NOT_APPLICABLE"]}
        }
      },
      "then": {
        "required": ["reason"],
        "properties": {"evidence_mode": {"const": "NONE"}},
        "not": {"required": ["expected_evidence_modes"]}
      }
    }
  ]
}
