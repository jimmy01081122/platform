{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/moe-simulator/phase7/identity-contract-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "mode",
    "runtime_variant_hash",
    "request_set",
    "arrival_trace",
    "generation_parameters",
    "execution_validity",
    "completion_set",
    "blocking_fields",
    "routing_comparison",
    "aggregate_routing_demand",
    "observational_fields"
  ],
  "properties": {
    "contract_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["SINGLE_REQUEST", "SERVING_REPLAY"]},
    "runtime_variant_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_set": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "input_token_ids", "output_token_ids", "stop_reason"],
        "properties": {
          "request_id": {"type": "string", "minLength": 1},
          "input_token_ids": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0}
          },
          "output_token_ids": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0}
          },
          "stop_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "arrival_trace": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "arrival_time_fs"],
        "properties": {
          "request_id": {"type": "string", "minLength": 1},
          "arrival_time_fs": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}
        }
      }
    },
    "generation_parameters": {"type": "object"},
    "execution_validity": {"enum": ["VALID", "INVALID"]},
    "completion_set": {
      "type": ["array", "null"],
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "blocking_fields": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "routing_comparison": {
      "enum": [
        "TOPK_AMBIGUITY_RULE_WEIGHTS_TOLERANCE_BOUND",
        "AGGREGATE_CONFIDENCE_BOUND"
      ]
    },
    "aggregate_routing_demand": {
      "enum": [null, "CONFIDENCE_BOUND"]
    },
    "observational_fields": {
      "type": "array",
      "items": {
        "enum": ["batch_formation", "schedule", "stream_ordering", "event_timing"]
      },
      "uniqueItems": true
    }
  }
}
