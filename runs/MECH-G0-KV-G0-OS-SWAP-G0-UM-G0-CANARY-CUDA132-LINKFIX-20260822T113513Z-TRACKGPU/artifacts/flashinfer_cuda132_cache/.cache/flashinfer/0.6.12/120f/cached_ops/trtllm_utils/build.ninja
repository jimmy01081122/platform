ninja_required_version = 1.3
name = trtllm_utils
cuda_home = /workspace/toolchains/cuda_13_2_86_flashinfer/nvidia/cu13
cxx = c++
nvcc = $cuda_home/bin/nvcc
cxx_launcher = 
nvcc_launcher = 

common_cflags = -DPy_LIMITED_API=0x03090000 $
    -D_GLIBCXX_USE_CXX11_ABI=1 $
    -I/workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/flashinfer/data/csrc/nv_internal $
    -I/workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/flashinfer/data/csrc/nv_internal/include $
    -I/workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/flashinfer/data/csrc/nv_internal/tensorrt_llm/cutlass_extensions/include $
    -I/workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/flashinfer/data/csrc/nv_internal/tensorrt_llm/kernels/cutlass_kernels/include $
    -I/workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/flashinfer/data/csrc/nv_internal/tensorrt_llm/kernels/cutlass_kernels $
    -I/workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/flashinfer/data/cccl/cub $
    -I/workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/flashinfer/data/cccl/libcudacxx/include $
    -I/workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/flashinfer/data/cccl/thrust $
    -isystem /usr/include/python3.10 $
    -isystem $cuda_home/include $
    -isystem /workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/tvm_ffi/include $
    -isystem /workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/tvm_ffi/include $
    -isystem /workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/flashinfer/data/include $
    -isystem /workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/flashinfer/data/csrc $
    -isystem /workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/flashinfer/data/cutlass/include $
    -isystem /workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/flashinfer/data/cutlass/tools/util/include $
    -isystem /workspace/venvs/track_gpu_vllm_0_23_py310/lib/python3.10/site-packages/flashinfer/data/spdlog/include
cflags = $common_cflags $
    -fPIC $
    -std=c++17 $
    -Wno-switch-bool $
    -DNDEBUG $
    -O3
post_cflags =
cuda_cflags = $common_cflags $
    --compiler-options=-fPIC $
    --expt-relaxed-constexpr $
    -static-global-template-stub=false $
    -gencode=arch=compute_120f,code=sm_120f $
    -DFLASHINFER_ENABLE_FP8_E8M0 $
    -DFLASHINFER_ENABLE_FP4_E2M1 $
    -std=c++17 $
    --threads=1 $
    -use_fast_math $
    -Xfatbin=-compress-all $
    -DFLASHINFER_ENABLE_F16 $
    -DFLASHINFER_ENABLE_BF16 $
    -DFLASHINFER_ENABLE_FP8_E4M3 $
    -DFLASHINFER_ENABLE_FP8_E5M2 $
    -DNDEBUG $
    -O3
cuda_post_cflags =
ldflags = -shared $
    -L$cuda_home/lib64 $
    -L$cuda_home/lib64/stubs $
    -lcudart $
    -lcuda

rule compile
  command = $cxx_launcher $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc_launcher $nvcc --generate-dependencies-with-compile -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags
  depfile = $out.d
  deps = gcc

rule link
  command = $cxx $in $ldflags -o $out

