{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c1_session.schema.json",
  "type": "object",
  "required": ["schema_version", "session_id", "suite", "model", "hardware_session_id", "pass_plan", "raw_immutable"],
  "properties": {
    "schema_version": {"const": "c1-session-v1"},
    "session_id": {"type": "string", "minLength": 1},
    "suite": {
      "type": "object",
      "required": ["suite_id", "suite_version", "samples", "repetitions"],
      "properties": {
        "suite_id": {"type": "string", "minLength": 1},
        "suite_version": {"type": "string", "minLength": 1},
        "samples": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["benchmark_id", "sample_id"]}},
        "repetitions": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "required": ["model_id", "model_revision", "tokenizer_revision"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "tokenizer_revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "hardware_session_id": {"type": "string", "minLength": 1},
    "pass_plan": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["P0", "P1", "P2", "P3", "P5_BASIC"]}
    },
    "quality_contract": {
      "type": "object",
      "required": [
        "path", "sha256", "contract_revision", "evaluator_revision",
        "evaluator_source_path", "evaluator_sha256", "quality_engine_path",
        "quality_engine_sha256", "reference_bundle_sha256"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "contract_revision": {"type": "string", "minLength": 1},
        "evaluator_revision": {"type": "string", "minLength": 1},
        "evaluator_source_path": {"type": "string", "minLength": 1},
        "evaluator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "quality_engine_path": {"type": "string", "minLength": 1},
        "quality_engine_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "raw_immutable": {"const": true}
  },
  "additionalProperties": true
}
