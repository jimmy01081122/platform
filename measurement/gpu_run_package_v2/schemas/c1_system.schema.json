{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c1_system.schema.json",
  "type": "object",
  "required": ["schema_version", "event_type", "event_key", "request_id", "token_id", "layer_id", "expert_id", "timestamp_class", "provenance"],
  "properties": {
    "schema_version": {"const": "c1-system-event-v1"},
    "event_type": {"const": "EXPERT_ROUTE"},
    "event_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "minLength": 1},
    "token_id": {"type": "integer", "minimum": 0},
    "layer_id": {"type": "integer", "minimum": 0},
    "expert_id": {"type": "integer", "minimum": 0},
    "logical_order": {"type": "integer", "minimum": 0},
    "timestamp_class": {"const": "logical"},
    "provenance": {
      "type": "object",
      "required": ["routing", "timing"],
      "properties": {
        "routing": {"const": "measured"},
        "timing": {"const": "unassigned"}
      },
      "additionalProperties": false
    }
  },
  "not": {"anyOf": [
    {"required": ["timestamp_ns"]},
    {"required": ["duration_ns"]},
    {"required": ["pcie_latency_ns"]},
    {"required": ["expert_weight_bytes"]},
    {"required": ["activation_bytes"]}
  ]},
  "additionalProperties": true
}
