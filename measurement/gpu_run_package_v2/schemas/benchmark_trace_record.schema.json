{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark_trace_record.schema.json",
  "type": "object",
  "required": [
    "schema_version", "record_id", "model_id", "model_revision",
    "weights_revision", "tokenizer_revision", "suite_id", "benchmark_id",
    "sample_id", "template_id", "template_hash", "prompt_hash",
    "generation_config", "generation_config_hash", "actual_tokens",
    "output_hash", "quality", "serving_runtime", "serving", "hardware_id",
    "hardware",
    "repetition_index", "request_index", "profiler_pass", "native_format",
    "native_paths", "native_sha256", "native_checksums", "environment_hash", "alignment",
    "completeness"
  ],
  "properties": {
    "schema_version": {"const": "benchmark-trace-record-v1"},
    "record_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "weights_revision": {"type": "string", "minLength": 1},
    "tokenizer_revision": {"type": "string", "minLength": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "template_id": {"type": "string", "minLength": 1},
    "template_hash": {"$ref": "#/$defs/hash"},
    "prompt_hash": {"$ref": "#/$defs/hash"},
    "generation_config": {"type": "object"},
    "generation_config_hash": {"$ref": "#/$defs/hash"},
    "actual_tokens": {
      "type": "object",
      "required": [
        "prompt", "generated", "total", "prompt_token_ids",
        "generated_token_ids", "token_ids_hash"
      ],
      "properties": {
        "prompt": {"type": "integer", "minimum": 0},
        "generated": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "prompt_token_ids": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "generated_token_ids": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "token_ids_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "output_hash": {"$ref": "#/$defs/hash"},
    "quality": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pass", "fail", "unknown"]},
        "score": {"type": ["number", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "serving_runtime": {"type": "string", "minLength": 1},
    "serving": {"type": "object"},
    "hardware_id": {"type": "string", "minLength": 1},
    "hardware": {"type": "object"},
    "repetition_index": {"type": "integer", "minimum": 0},
    "request_index": {"type": "integer", "minimum": 0},
    "profiler_pass": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6"]},
    "native_format": {"type": "string", "minLength": 1},
    "native_paths": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "native_sha256": {"$ref": "#/$defs/hash"},
    "native_checksums": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "environment_hash": {"$ref": "#/$defs/hash"},
    "alignment": {
      "type": "object",
      "required": [
        "suite_id", "sample_id", "model_revision", "generation_config_hash",
        "seed", "request_id", "token_index", "layer_index",
        "repetition_index", "session_id", "alignment_key"
      ],
      "properties": {
        "seed": {"type": "integer", "minimum": 0},
        "token_index": {"type": "integer", "minimum": 0},
        "layer_index": {"type": "integer", "minimum": 0},
        "repetition_index": {"type": "integer", "minimum": 0},
        "generation_config_hash": {"$ref": "#/$defs/hash"},
        "alignment_key": {"$ref": "#/$defs/hash"}
      }
    },
    "completeness": {
      "type": "object",
      "required": ["complete", "missing_fields"],
      "properties": {
        "complete": {"type": "boolean"},
        "missing_fields": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "truncated": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
