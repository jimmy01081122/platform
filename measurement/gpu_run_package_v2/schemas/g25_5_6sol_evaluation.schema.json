{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgehetero.local/schemas/g25_5_6sol_evaluation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evaluation_id", "evaluated_at_epoch", "evaluator",
    "review_target", "same_source_review_sha256", "source_bindings_sha256",
    "package_checksum_ledger_sha256", "exact_command", "verdict", "blockers"
  ],
  "properties": {
    "schema_version": {"const": "g25-5.6sol-evaluation-v1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "evaluated_at_epoch": {"type": "number", "minimum": 0},
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_alias", "model"],
      "properties": {
        "gate_alias": {"const": "5.6sol"},
        "model": {"const": "gpt-5.6-sol"}
      }
    },
    "review_target": {"$ref": "#/$defs/reviewTarget"},
    "same_source_review_sha256": {"$ref": "#/$defs/sha256"},
    "source_bindings_sha256": {"$ref": "#/$defs/sha256"},
    "package_checksum_ledger_sha256": {"$ref": "#/$defs/sha256"},
    "exact_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "argv_sha256"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "argv_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verdict": {"const": "GO"},
    "blockers": {"const": []}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotated_tag", "tag_object", "commit", "tree", "package_tree"],
      "properties": {
        "annotated_tag": {"type": "string", "minLength": 1},
        "tag_object": {"$ref": "#/$defs/gitObject"},
        "commit": {"$ref": "#/$defs/gitObject"},
        "tree": {"$ref": "#/$defs/gitObject"},
        "package_tree": {"$ref": "#/$defs/gitObject"}
      }
    }
  }
}
