{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgehetero.local/schemas/g25_same_source_review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_id", "issued_at_epoch", "review_target",
    "package_identity", "source_bindings", "exact_command", "roles", "overall"
  ],
  "properties": {
    "schema_version": {"const": "g25-same-source-review-v1"},
    "review_id": {"type": "string", "minLength": 1},
    "issued_at_epoch": {"type": "number", "minimum": 0},
    "review_target": {"$ref": "#/$defs/reviewTarget"},
    "package_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_count", "checksum_entry_count", "checksums_sha256",
        "package_manifest_sha256"
      ],
      "properties": {
        "inventory_count": {"type": "integer", "minimum": 1},
        "checksum_entry_count": {"type": "integer", "minimum": 1},
        "checksums_sha256": {"$ref": "#/$defs/sha256"},
        "package_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "exact_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "argv_sha256"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "argv_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture_system", "model_benchmark", "trace_provenance"],
      "properties": {
        "architecture_system": {"$ref": "#/$defs/role"},
        "model_benchmark": {"$ref": "#/$defs/role"},
        "trace_provenance": {"$ref": "#/$defs/role"}
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "blockers"],
      "properties": {
        "verdict": {"const": "GO"},
        "blockers": {"const": []}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotated_tag", "tag_object", "commit", "tree", "package_tree"],
      "properties": {
        "annotated_tag": {"type": "string", "minLength": 1},
        "tag_object": {"$ref": "#/$defs/gitObject"},
        "commit": {"$ref": "#/$defs/gitObject"},
        "tree": {"$ref": "#/$defs/gitObject"},
        "package_tree": {"$ref": "#/$defs/gitObject"}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "verdict", "blockers"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "verdict": {"const": "GO"},
        "blockers": {"const": []}
      }
    }
  }
}
