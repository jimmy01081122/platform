{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical_pass_ir.schema.json",
  "title": "Canonical per-pass benchmark IR",
  "type": "object",
  "required": [
    "schema_version",
    "pass_id",
    "source_content_ids",
    "measured_sample_count",
    "warmup_excluded",
    "records"
  ],
  "properties": {
    "schema_version": {"const": "m0-canonical-pass-v2"},
    "pass_id": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6"]},
    "source_content_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "measured_sample_count": {"type": "integer", "minimum": 0},
    "warmup_excluded": {"const": true},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "source_record_id",
          "alignment",
          "benchmark_id",
          "sample_id",
          "prompt_hash",
          "output_hash",
          "actual_tokens",
          "quality",
          "measurement"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "source_record_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
