{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c1_quality.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "v1": {
      "type": "object",
      "required": ["schema_version", "execution_alignment_key", "status", "output_nonempty", "finite_values", "token_count_consistent", "expert_ids_legal", "instrumentation_semantic_interference"],
      "properties": {
        "schema_version": {"const": "c1-quality-v1"},
        "execution_alignment_key": {"$ref": "#/$defs/hash"},
        "status": {"enum": ["pass", "fail", "unknown"]},
        "output_nonempty": {"type": "boolean"},
        "finite_values": {"type": "boolean"},
        "token_count_consistent": {"type": "boolean"},
        "expert_ids_legal": {"type": ["boolean", "null"]},
        "instrumentation_semantic_interference": {"type": ["boolean", "null"]},
        "benchmark_parseable": {"type": ["boolean", "null"]},
        "score": {"type": ["number", "null"]},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "v2": {
      "type": "object",
      "required": [
        "schema_version", "contract_path", "contract_sha256",
        "contract_revision", "evaluator_revision", "evaluator_source_path",
        "evaluator_sha256", "quality_engine_path", "quality_engine_sha256",
        "reference_bundle_sha256",
        "reference_sha256", "execution_alignment_key", "pass_id", "output_hash",
        "output_nonempty", "finite_values", "token_count_consistent",
        "expert_ids_legal", "stop_reason", "legal_stop", "task_class", "evaluator",
        "parser_outcome", "task_outcome", "quality_role", "task_capability",
        "qg1", "qg2",
        "qg3", "qg4", "blocking_status", "blocking_reasons",
        "quality_binding_sha256"
      ],
      "properties": {
        "schema_version": {"const": "c1-quality-v2"},
        "contract_path": {"type": "string", "minLength": 1},
        "contract_sha256": {"$ref": "#/$defs/hash"},
        "contract_revision": {"type": "string", "minLength": 1},
        "evaluator_revision": {"type": "string", "minLength": 1},
        "evaluator_source_path": {"type": "string", "minLength": 1},
        "evaluator_sha256": {"$ref": "#/$defs/hash"},
        "quality_engine_path": {"type": "string", "minLength": 1},
        "quality_engine_sha256": {"$ref": "#/$defs/hash"},
        "reference_bundle_sha256": {"$ref": "#/$defs/hash"},
        "reference_sha256": {"$ref": "#/$defs/hash"},
        "execution_alignment_key": {"$ref": "#/$defs/hash"},
        "pass_id": {"enum": ["P0", "P1", "P2", "P3", "P5_BASIC"]},
        "output_hash": {"$ref": "#/$defs/hash"},
        "output_nonempty": {"type": "boolean"},
        "finite_values": {"type": "boolean"},
        "token_count_consistent": {"type": "boolean"},
        "expert_ids_legal": {"type": ["boolean", "null"]},
        "stop_reason": {"type": "string", "minLength": 1},
        "legal_stop": {"type": "boolean"},
        "task_class": {"enum": ["T0", "T1", "T2", "unknown"]},
        "evaluator": {
          "enum": [
            "t0_integer_semantics_v1", "gsm8k_last_number", "mmlu_choice", "unknown"
          ]
        },
        "parser_outcome": {"enum": ["parseable", "unparseable", "evaluator_error", "unknown"]},
        "task_outcome": {"enum": ["correct", "incorrect", "unknown"]},
        "quality_role": {"const": "observational"},
        "task_capability": {"const": "not_inferred"},
        "qg1": {"enum": ["pass", "fail"]},
        "qg2": {"const": "pending_cross_pass"},
        "qg3": {"enum": ["pass", "fail", "not_applicable"]},
        "qg4": {"enum": ["recorded_nonblocking", "not_applicable"]},
        "blocking_status": {"enum": ["pass", "fail"]},
        "blocking_reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "quality_binding_sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    }
  }
}
