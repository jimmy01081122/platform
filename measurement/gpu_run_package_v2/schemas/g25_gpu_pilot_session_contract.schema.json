    "execution_scope": {"type": "object"},
    "matrix_path": {"type": "string"},
    "generation_profile_path": {"type": "string"},
    "expected_artifacts_path": {"type": "string"},
    "frozen_identity": {"type": "object"},
    "generation": {"type": "object"},
    "process_strategy": {"type": "object"},
    "deadlines": {"type": "object"},
    "failure_and_resume": {"type": "object"},
    "preflight": {"type": "object"},
    "selector": {"type": "object"},
    "gpu_application_blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
