{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgehetero.local/schemas/g25_qualification_cell.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "session_id", "cell_id", "evidence_role",
    "formal_c1_evidence", "synthetic", "instance_id", "sample_id", "task_id",
    "ceiling", "generation_profile", "generation_profile_sha256",
    "generation_config_sha256",
    "prompt_hash", "input_hash", "input_token_count", "output_token_count",
    "stop_reason", "wall_time_seconds", "generation_seconds",
    "process_return_code", "timed_out", "execution_status",
    "qualification_class", "classification_reason", "output_hash",
    "output_token_ids_sha256", "parser_outcome",
    "worker_claimed_stop_reason", "worker_claimed_parser_outcome",
    "parent_output_replay", "parent_output_replay_sha256",
    "routing_capture_enabled", "profiler_enabled", "execution_identity",
    "execution_identity_sha256", "worker_evidence_sha256",
    "evidence_paths"
  ],
  "properties": {
    "schema_version": {"const": "g25-qualification-cell-v2"},
    "session_id": {"type": "string", "minLength": 1},
    "cell_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_role": {"const": "termination_qualification_non_formal"},
    "formal_c1_evidence": {"const": false},
    "synthetic": {"type": "boolean"},
    "instance_id": {"type": "string", "pattern": "^c1a-t1-[0-9]{2}$"},
    "sample_id": {"type": "string", "minLength": 1},
    "task_id": {"const": "T1"},
    "ceiling": {"enum": [256, 384, 512]},
    "generation_profile": {"const": "granite_c1_natural_qualification_v1"},
    "generation_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generation_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "input_token_count": {"type": ["integer", "null"], "minimum": 0},
    "output_token_count": {"type": ["integer", "null"], "minimum": 0},
    "stop_reason": {"type": ["string", "null"]},
    "wall_time_seconds": {"type": ["number", "null"], "minimum": 0},
    "generation_seconds": {"type": ["number", "null"], "minimum": 0},
    "process_return_code": {"type": ["integer", "null"]},
    "timed_out": {"type": ["boolean", "null"]},
    "execution_status": {"enum": ["complete", "failed", "timeout", "invalid_evidence"]},
    "qualification_class": {"enum": ["QUALIFIED", "TRUNCATED", "TIMEOUT", "INVALID_OUTPUT", "RUNTIME_FAILURE", "INVALID_EVIDENCE"]},
    "classification_reason": {"type": "string", "minLength": 1},
    "output_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "output_token_ids_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "parser_outcome": {"enum": ["parseable", "unparseable", "not_run", "unknown"]},
    "worker_claimed_stop_reason": {"type": ["string", "null"]},
    "worker_claimed_parser_outcome": {
      "enum": ["parseable", "unparseable", "not_run", "unknown"]
    },
    "parent_output_replay": {
      "$ref": "https://edgehetero.local/schemas/g25_parent_output_replay.schema.json"
    },
    "parent_output_replay_sha256": {
      "type": "string", "pattern": "^[0-9a-f]{64}$"
    },
    "routing_capture_enabled": {"const": false},
    "profiler_enabled": {"const": false},
    "execution_identity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "runtime", "device"],
      "properties": {
        "mode": {"type": "string", "minLength": 1},
        "runtime": {"type": "object"},
        "device": {"type": "object"}
      }
    },
    "execution_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "worker_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_paths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ceiling": {"const": 256},
          "qualification_class": {"const": "QUALIFIED"}
        },
        "required": ["ceiling", "qualification_class"]
      },
      "then": {
        "properties": {
          "output_token_count": {"type": "integer", "minimum": 1, "maximum": 256},
          "parent_output_replay": {
            "properties": {
              "frozen_ceiling": {"const": 256},
              "within_frozen_ceiling": {"const": true},
              "legal_stop": {"const": true},
              "derived_stop_reason": {"const": "eos_token"}
            },
            "required": [
              "frozen_ceiling", "within_frozen_ceiling", "legal_stop",
              "derived_stop_reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ceiling": {"const": 384},
          "qualification_class": {"const": "QUALIFIED"}
        },
        "required": ["ceiling", "qualification_class"]
      },
      "then": {
        "properties": {
          "output_token_count": {"type": "integer", "minimum": 1, "maximum": 384},
          "parent_output_replay": {
            "properties": {
              "frozen_ceiling": {"const": 384},
              "within_frozen_ceiling": {"const": true},
              "legal_stop": {"const": true},
              "derived_stop_reason": {"const": "eos_token"}
            },
            "required": [
              "frozen_ceiling", "within_frozen_ceiling", "legal_stop",
              "derived_stop_reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ceiling": {"const": 512},
          "qualification_class": {"const": "QUALIFIED"}
        },
        "required": ["ceiling", "qualification_class"]
      },
      "then": {
        "properties": {
          "output_token_count": {"type": "integer", "minimum": 1, "maximum": 512},
          "parent_output_replay": {
            "properties": {
              "frozen_ceiling": {"const": 512},
              "within_frozen_ceiling": {"const": true},
              "legal_stop": {"const": true},
              "derived_stop_reason": {"const": "eos_token"}
            },
            "required": [
              "frozen_ceiling", "within_frozen_ceiling", "legal_stop",
              "derived_stop_reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"qualification_class": {"const": "QUALIFIED"}},
        "required": ["qualification_class"]
      },
      "then": {
        "properties": {
          "parent_output_replay": {
            "properties": {
              "eos_occurrence_count": {"const": 1},
              "eos_is_unique_terminal": {"const": true},
              "within_frozen_ceiling": {"const": true},
              "legal_stop": {"const": true},
              "derived_stop_reason": {"const": "eos_token"},
              "replay_error": {"type": "null"}
            },
            "required": [
              "eos_occurrence_count", "eos_is_unique_terminal",
              "within_frozen_ceiling", "legal_stop", "derived_stop_reason",
              "replay_error"
            ]
          }
        }
      }
    }
  ]
}
