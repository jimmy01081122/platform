{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scheduler_state.schema.json",
  "title": "C1 Scheduler State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_unit", "state", "attempts", "reason"],
  "properties": {
    "schema_version": {
      "const": "scheduler-state-v1"
    },
    "work_unit": {
      "$ref": "c1_work_unit.schema.json"
    },
    "state": {
      "enum": [
        "PENDING",
        "PREFLIGHT",
        "RUNNING",
        "RAW_SAVED",
        "VALIDATING",
        "COMPLETE",
        "FAILED_RETRYABLE",
        "FAILED_TERMINAL",
        "SKIPPED",
        "UNAVAILABLE"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "type": ["string", "null"]
    }
  }
}
