{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgehetero.local/schemas/g25_expected_artifacts.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "session_files", "per_cell_directories", "expected_raw_files", "expected_cell_files", "application_session_files", "application_per_cell_directories", "partial_session_rule", "required_bindings", "audit_requirements", "forbidden_artifacts", "release"],
  "properties": {
    "schema_version": {"const": "g25-expected-artifacts-v1"},
    "revision": {"type": "string"},
    "session_files": {"const": ["session.json", "ledger.json", "verdict.json", "audit.json"]},
    "per_cell_directories": {"const": ["raw", "cells"]},
    "expected_raw_files": {"const": 12},
    "expected_cell_files": {"const": 12},
    "application_session_files": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
    "application_per_cell_directories": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "partial_session_rule": {"type": "object"},
    "required_bindings": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
    "audit_requirements": {"type": "object"},
    "forbidden_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "release": {"type": "object"}
  }
}
